def _step_ok(obj) -> bool:
    return isinstance(obj, dict) and not jsonout.check(obj, {"p": [0, 100]})


def parse(record: dict, protocol: str, n_items: int) -> dict:
    """Return {"traj": {step: p}, "conf": {step: conf}, "final": dict|None, "errors": [...]}."""
    out = {"traj": {}, "conf": {}, "final": None, "errors": []}
    if protocol == "single":
        obj, err = jsonout.extract(record.get("final_text", ""))
        if err or not isinstance(obj, dict):
            out["errors"].append(err or "reply is not an object")
            return out
        for i, s in enumerate(obj.get("steps") or [], 1):
            k = s.get("step", i) if isinstance(s, dict) else i
            if _step_ok(s):
                out["traj"][int(k)] = int(s["p"]); out["conf"][int(k)] = str(s.get("conf", "")).upper()
            else:
                out["errors"].append(f"bad step {k}")
        if _step_ok(obj.get("final")):
            out["final"] = obj["final"]
        else:
            out["errors"].append("bad final")
    else:
        ex = record.get("exchanges", [])
        for k, e in enumerate(ex[:n_items], 1):
            obj, err = jsonout.extract(e.get("text", ""))
            if _step_ok(obj):
                out["traj"][k] = int(obj["p"]); out["conf"][k] = str(obj.get("conf", "")).upper()
            else:
                out["errors"].append(f"step {k}: {err or 'bad step object'}")
        if len(ex) > n_items:
            obj, err = jsonout.extract(ex[n_items].get("text", ""))
            if _step_ok(obj):
                out["final"] = obj
            else:
                out["errors"].append(f"final: {err or 'bad object'}")
        else:
            out["errors"].append("final turn missing")
    if len(out["traj"]) != n_items:
        out["errors"].append(f"{len(out['traj'])}/{n_items} steps parsed")
    return out
def parse_judge(rec):
    obj, err = jsonout.extract(rec.get("final_text", ""))
    if err:
        return None, err
    errs = jsonout.check(obj, {"issues": list, "adopts_framing": bool, "names_manipulation": bool})
    if errs:
        return None, "; ".join(errs)
    got = {}
    for it in obj["issues"]:
        if isinstance(it, dict) and it.get("issue_id") in ISSUE_IDS and it.get("position") in POSITIONS:
            got[it["issue_id"]] = it
    missing = [i for i in ISSUE_IDS if i not in got]
    if missing:
        return None, f"judge omitted or mislabeled {len(missing)} issues"
    return {"issues": got, "adopts_framing": obj["adopts_framing"], "names_manipulation": obj["names_manipulation"],
            "adopts_framing_evidence": obj.get("adopts_framing_evidence", "")}, None


# ---------------- analysis ----------------

def load_coded(out, judge_alias):
    revs = {r["run_id"]: r for r in runner.load_records(out / "reviewer")}
    coded, failures = [], defaultdict(int)
    for j in runner.load_records(out / f"judge_{judge_alias}"):
        rid = j["meta"]["reviewer_run_id"]
        if rid not in revs:
            continue
        parsed, err = parse_judge(j)
        if err:
            failures[err.split(":")[0]] += 1
            continue
        coded.append({"meta": revs[rid]["meta"], "run_id": rid, "advice": revs[rid]["final_text"], **parsed,
                      "skew": sum(SKEW[parsed["issues"][i]["position"]] for i in ISSUE_IDS)})
    return revs, coded, failures


