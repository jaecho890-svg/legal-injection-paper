"""
stats.py - the statistics the paper reports, standard library only.

  mean_ci        mean with a percentile bootstrap confidence interval
  diff_ci        difference of two group means with a bootstrap CI
  perm_test      two-sided permutation test for a difference in means
  wilson         Wilson score interval for a proportion
  holm           Holm-Bonferroni adjustment for a family of p-values
  cohen_kappa    agreement between two coders (e.g. automated judge vs human)

All resampling is seeded so the numbers in the paper reproduce exactly.
"""
import math
import random
from collections import Counter
from typing import Dict, List, Optional, Sequence, Tuple

B = 10000
SEED = 20261104


def mean(xs: Sequence[float]) -> float:
    return sum(xs) / len(xs) if xs else float("nan")


def sd(xs: Sequence[float]) -> float:
    if len(xs) < 2:
        return float("nan")
    m = mean(xs)
    return math.sqrt(sum((x - m) ** 2 for x in xs) / (len(xs) - 1))


def _pct(sorted_xs: List[float], q: float) -> float:
    if not sorted_xs:
        return float("nan")
    k = (len(sorted_xs) - 1) * q
    lo, hi = math.floor(k), math.ceil(k)
    return sorted_xs[lo] + (sorted_xs[hi] - sorted_xs[lo]) * (k - lo)


def mean_ci(xs: Sequence[float], alpha: float = 0.05, b: int = B, seed: int = SEED) -> Tuple[float, float, float]:
    xs = list(xs)
    if not xs:
        return (float("nan"),) * 3
    if len(xs) == 1:
        return xs[0], float("nan"), float("nan")
    rng = random.Random(seed)
    n = len(xs)
    boots = sorted(mean([xs[rng.randrange(n)] for _ in range(n)]) for _ in range(b))
    return mean(xs), _pct(boots, alpha / 2), _pct(boots, 1 - alpha / 2)


def diff_ci(a: Sequence[float], b_: Sequence[float], alpha: float = 0.05, b: int = B,
            seed: int = SEED) -> Tuple[float, float, float]:
    """mean(a) - mean(b_), resampling each group independently."""
    a, b_ = list(a), list(b_)
    if not a or not b_:
        return (float("nan"),) * 3
    rng = random.Random(seed)
    na, nb = len(a), len(b_)
    boots = sorted(mean([a[rng.randrange(na)] for _ in range(na)]) - mean([b_[rng.randrange(nb)] for _ in range(nb)])
                   for _ in range(b))
    return mean(a) - mean(b_), _pct(boots, alpha / 2), _pct(boots, 1 - alpha / 2)


def perm_test(a: Sequence[float], b_: Sequence[float], b: int = B, seed: int = SEED) -> float:
    a, b_ = list(a), list(b_)
    if len(a) < 2 or len(b_) < 2:
        return float("nan")
    obs = abs(mean(a) - mean(b_))
    pooled = a + b_
    na = len(a)
    rng = random.Random(seed)
    hits = 0
    for _ in range(b):
        rng.shuffle(pooled)
        if abs(mean(pooled[:na]) - mean(pooled[na:])) >= obs - 1e-12:
            hits += 1
    return (hits + 1) / (b + 1)


def wilson(k: int, n: int, z: float = 1.959964) -> Tuple[float, float, float]:
    if n == 0:
        return (float("nan"),) * 3
    p = k / n
    den = 1 + z * z / n
    centre = (p + z * z / (2 * n)) / den
    half = z * math.sqrt(p * (1 - p) / n + z * z / (4 * n * n)) / den
    return p, max(0.0, centre - half), min(1.0, centre + half)


def holm(pvals: Dict[str, float]) -> Dict[str, float]:
    items = sorted(((p, k) for k, p in pvals.items() if not math.isnan(p)))
    m = len(items)
    out, running = {}, 0.0
    for i, (p, k) in enumerate(items):
        running = max(running, min(1.0, (m - i) * p))
        out[k] = running
    for k, p in pvals.items():
        out.setdefault(k, float("nan"))
    return out


def cohen_kappa(x: Sequence[str], y: Sequence[str]) -> float:
    if len(x) != len(y) or not x:
        return float("nan")
    n = len(x)
    po = sum(a == b for a, b in zip(x, y)) / n
    cx, cy = Counter(x), Counter(y)
    pe = sum(cx[c] * cy[c] for c in set(cx) | set(cy)) / (n * n)
    return 1.0 if pe == 1 else (po - pe) / (1 - pe)


def fmt_ci(m: float, lo: float, hi: float, digits: int = 1) -> str:
    if math.isnan(m):
        return "n/a"
    if math.isnan(lo):
        return f"{m:.{digits}f}"
    return f"{m:.{digits}f} [{lo:.{digits}f}, {hi:.{digits}f}]"


def fmt_p(p: Optional[float]) -> str:
    if p is None or math.isnan(p):
        return "n/a"
    return "<0.001" if p < 0.001 else f"{p:.3f}"
"""
jsonout.py - pull a JSON value out of a model reply and check it against a small schema.

Models are asked to end with a JSON object. Replies sometimes wrap it in a ```json fence
or add prose around it, so extraction tries, in order: the last fenced block, the whole
reply, then the last balanced {...} or [...] in the text. Anything that still fails is
reported as a parse failure and counted in the analysis; it is never silently scored.
"""
import json
import re
from typing import Any, List, Optional, Tuple

_FENCE = re.compile(r"```(?:json)?\s*(.*?)```", re.DOTALL | re.IGNORECASE)


def _last_top_level(text: str) -> Optional[Any]:
    """Scan left to right, decoding a JSON value wherever one starts; return the last top-level one."""
    dec = json.JSONDecoder()
    i, last = 0, None
    while i < len(text):
        if text[i] in "{[":
            try:
                obj, end = dec.raw_decode(text, i)
                last, i = obj, end
                continue
            except json.JSONDecodeError:
                pass
        i += 1
    return last


def extract(text: str) -> Tuple[Optional[Any], Optional[str]]:
    if not text or not text.strip():
        return None, "empty reply"
    fences = _FENCE.findall(text)
    for block in reversed(fences):
        try:
            return json.loads(block.strip()), None
        except json.JSONDecodeError:
            continue
    try:
        return json.loads(text.strip()), None
    except json.JSONDecodeError:
        pass
    cand = _last_top_level(text)
    if cand is not None:
        return cand, None
    return None, "no parseable JSON found"


# ---------- tiny schema checks ----------

def check(obj: Any, required: dict) -> List[str]:
    """required maps key -> one of: type, tuple of allowed values, or (min, max) int range as a list."""
    errs = []
    if not isinstance(obj, dict):
        return [f"expected object, got {type(obj).__name__}"]
    for k, rule in required.items():
        if k not in obj:
            errs.append(f"missing '{k}'")
            continue
        v = obj[k]
        if isinstance(rule, tuple):
            if v not in rule:
                errs.append(f"'{k}'={v!r} not in {rule}")
        elif isinstance(rule, list) and len(rule) == 2:
            if not isinstance(v, (int, float)) or isinstance(v, bool) or not (rule[0] <= v <= rule[1]):
                errs.append(f"'{k}'={v!r} outside {rule}")
        elif isinstance(rule, type):
            if not isinstance(v, rule) or (rule is int and isinstance(v, bool)):
                errs.append(f"'{k}' should be {rule.__name__}")
    return errs
"""
annotate.py - blinded human validation of the automated judge.

export: write a spreadsheet of judged items with the condition and model hidden and the
        rows shuffled, plus a separate key file. A human coder (ideally a lawyer) fills
        in human_label without seeing the judge's label or the condition.
kappa:  read the filled sheet back and report agreement with the judge (Cohen's kappa
        and raw agreement, per field and overall) plus a confusion table.

Usage after a study's `export-annotation` command has written the files:
  python3 -m common.annotate kappa --sheet <sheet.csv> --key <key.json>
"""
import argparse
import csv
import json
import pathlib
import random
from collections import Counter, defaultdict
from typing import Dict, List, Optional

from . import stats


def export(items: List[dict], sheet: pathlib.Path, key: pathlib.Path, n: int, seed: int = 7) -> None:
    """items: dicts with key, field, options, text, auto_label. Sampling is stratified by
    (field, auto_label) so rare labels such as ACCEPT are represented."""
    rng = random.Random(seed)
    strata = defaultdict(list)
    for it in items:
        strata[(it["field"], it["auto_label"])].append(it)
    for v in strata.values():
        rng.shuffle(v)
    chosen, order = [], sorted(strata)
    while len(chosen) < min(n, len(items)):
        progressed = False
        for s in order:
            if strata[s] and len(chosen) < n:
                chosen.append(strata[s].pop()); progressed = True
        if not progressed:
            break
    rng.shuffle(chosen)
    sheet.parent.mkdir(parents=True, exist_ok=True)
    keymap = {}
    with sheet.open("w", newline="") as fh:
        w = csv.writer(fh)
        w.writerow(["blind_id", "field", "allowed_labels", "question", "text", "human_label", "notes"])
        for i, it in enumerate(chosen, 1):
            bid = f"A{i:04d}"
            w.writerow([bid, it["field"], " | ".join(it["options"]), it.get("question", ""), it["text"], "", ""])
            keymap[bid] = {"key": it["key"], "field": it["field"], "auto_label": it["auto_label"]}
    key.write_text(json.dumps(keymap, indent=2))
    print(f"wrote {len(chosen)} rows to {sheet} (key: {key}). Keep the key file away from the coder.")


def kappa(sheet: pathlib.Path, key: pathlib.Path, labels: Optional[Dict[str, str]] = None) -> str:
    """Human vs the judge whose labels are in the key; or, with `labels` (item key -> label), human vs
    another judge, counting only items that judge coded."""
    keymap = json.loads(key.read_text())
    by_field = defaultdict(lambda: ([], []))
    with sheet.open(encoding="utf-8-sig") as fh:
        for row in csv.DictReader(fh):
            h = row["human_label"].strip().upper()
            if not h:
                continue
            k = keymap[row["blind_id"]]
            judge = k["auto_label"] if labels is None else labels.get(k["key"])
            if judge is None:
                continue
            auto, hum = by_field[k["field"]]
            auto.append(str(judge).upper()); hum.append(h)
    lines = ["| field | n | agreement | Cohen's kappa |", "|---|---|---|---|"]
    all_a, all_h = [], []
    for f, (a, h) in sorted(by_field.items()):
        agree = sum(x == y for x, y in zip(a, h)) / len(a)
        lines.append(f"| {f} | {len(a)} | {agree:.2f} | {stats.cohen_kappa(a, h):.2f} |")
        all_a += a; all_h += h
    if all_a:
        agree = sum(x == y for x, y in zip(all_a, all_h)) / len(all_a)
        lines.append(f"| **all** | {len(all_a)} | {agree:.2f} | {stats.cohen_kappa(all_a, all_h):.2f} |")
        conf = Counter(zip(all_a, all_h))
        lines += ["", "Confusion (judge -> human):"] + [f"  {a} -> {h}: {c}" for (a, h), c in sorted(conf.items())]
    return "\n".join(lines)


def main():
    ap = argparse.ArgumentParser()
    sub = ap.add_subparsers(dest="cmd", required=True)
    k = sub.add_parser("kappa")
    k.add_argument("--sheet", required=True)
    k.add_argument("--key", required=True)
    args = ap.parse_args()
    print(kappa(pathlib.Path(args.sheet), pathlib.Path(args.key)))


if __name__ == "__main__":
    main()

